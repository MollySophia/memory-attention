+@pytest.mark.parametrize('policy', ['bulk', 'pipeline'])
+def test_async_pipeline_ids_fresh_values_and_capacity(model, policy):
+    model.config.memory_offload_policy = policy
+    model.config.memory_offload_group_size = 2
+    model.config.memory_offload_prefetch_depth = 1
+    model.fold_memory_table_on_gpu()
+    inputs = [torch.randint(0,128,(2,11),device='cuda') for _ in range(3)]
+    expected = [model(input_ids=ids,use_cache=False).logits.clone() for ids in inputs]
+    model.close_memory_offload()
+    model.enable_memory_offload()
+    streams = [torch.cuda.Stream(),torch.cuda.Stream()]
+    for stream in streams:
+        stream.wait_stream(torch.cuda.current_stream())
+    pointer = None
+    for index,(ids,reference) in enumerate(zip(inputs,expected)):
+        with torch.cuda.stream(streams[index%2]):
+            actual = model(input_ids=ids.clone(),use_cache=False).logits
+            torch.testing.assert_close(actual,reference,rtol=0,atol=0)
+            off = model.model.memory_offloader
+            if policy == 'pipeline':
+                assert off.ids_host.is_pinned()
+                if pointer is not None:
+                    assert pointer == off.ids_host.data_ptr()
+                pointer = off.ids_host.data_ptr()
+                torch.testing.assert_close(off.ids_host,ids.cpu(),rtol=0,atol=0)
+    torch.cuda.synchronize()
+    snapshot = load_script('benchmark_telemetry').memory_snapshot(model,'cuda')
+    extra = 2*11*8 if policy == 'pipeline' else 0
+    assert snapshot['offload_pinned_bytes'] == snapshot['offload_gpu_buffer_bytes'] + extra
+    torch.testing.assert_close(model(input_ids=inputs[0].cpu(),use_cache=False).logits,expected[0],rtol=0,atol=0)
+
+
+def test_embedding_dispatch_precedes_id_wait_and_failure_cleanup(model, monkeypatch):
+    model.config.memory_offload_policy = 'pipeline'
+    model.enable_memory_offload()
+    model.set_offload_offloader(2,11)
+    off = model.model.memory_offloader
+    ids = torch.randint(0,128,(2,11),device='cuda')
+    order = []
+    original_sync = torch.cuda.Event.synchronize
+    def tracked_sync(event):
+        if event is off.ids_ready:
+            order.append('id_wait')
+        return original_sync(event)
+    monkeypatch.setattr(torch.cuda.Event,'synchronize',tracked_sync)
+    hook = model.model.embeddings.register_forward_pre_hook(lambda *args: order.append('embedding'))
+    try:
+        expected = model(input_ids=ids,use_cache=False).logits.clone()
+        assert order.index('embedding') < order.index('id_wait')
+        order.clear()
+        with monkeypatch.context() as patch:
+            def fail(*args,**kwargs):
+                raise RuntimeError('injected embedding failure')
+            patch.setattr(model.model.embeddings,'forward',fail)
+            with pytest.raises(RuntimeError,match='injected embedding failure'):
+                model(input_ids=ids,use_cache=False)
+        assert order.index('embedding') < order.index('id_wait')
+        assert not model.model._offload_input_lock.locked()
+        torch.testing.assert_close(off.ids_host,ids.cpu(),rtol=0,atol=0)
+        actual = model(input_ids=ids,use_cache=False).logits
+        torch.testing.assert_close(actual,expected,rtol=0,atol=0)
+        model.model._offload_input_lock.acquire()
+        try:
+            with pytest.raises(RuntimeError,match='concurrent offloaded'):
+                model(input_ids=ids,use_cache=False)
+        finally:
+            model.model._offload_input_lock.release()
+    finally:
+        hook.remove()
