+@pytest.mark.parametrize('folded', [False, True])
+def test_fused_model_path_and_unfolded_fallback(model, monkeypatch, folded):
+    import fla.layers.memory_gather_add as fused
+    model.config.memory_offload_policy = 'pipeline'
+    model.config.memory_offload_dedup_min_tokens = 1
+    ids = torch.tensor([[7,1,7,9],[1,9,2,1]], device='cuda')
+    calls = []
+    original = fused.gather_add
+    def counted(*args):
+        calls.append(1)
+        return original(*args)
+    monkeypatch.setattr(fused, 'gather_add', counted)
+    if folded:
+        model.fold_memory_table_on_gpu()
+    with torch.inference_mode():
+        expected = model(input_ids=ids, use_cache=False).logits
+        model.close_memory_offload()
+        model.enable_memory_offload(fold_norm=folded)
+        actual = model(input_ids=ids, use_cache=False).logits
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    assert len(calls) == (model.config.num_hidden_layers if folded else 0)
+
