+@pytest.mark.parametrize('dtype', [torch.bfloat16, torch.float16, torch.float32])
+@pytest.mark.parametrize('width', [64, 128, 2048])
+def test_fused_gather_add_exact(dtype, width):
+    from fla.layers.memory_gather_add import gather_add
+    if not torch.cuda.is_available():
+        pytest.skip('requires CUDA')
+    torch.manual_seed(4321)
+    # A layer slice is strided when a group contains multiple layers.
+    rows = torch.randn(19, 3, width, device='cuda', dtype=dtype)[:, 1]
+    keys = torch.randn(2, 13, 2, width // 2, device='cuda', dtype=dtype)
+    for inverse in (torch.zeros(26, device='cuda', dtype=torch.long),
+                    torch.randint(0, 19, (26,), device='cuda')):
+        expected = keys + rows.index_select(0, inverse).view_as(keys)
+        actual = gather_add(keys, rows, inverse)
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+
