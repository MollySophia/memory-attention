+@pytest.mark.parametrize('group,depth', [(1,1),(2,1),(2,3)])
+def test_fused_handle_slot_reuse_and_fresh_inputs(group, depth):
+    from fla.layers.memory_offload import MemoryTableOffloader, FusedPendingM
+    if not torch.cuda.is_available():
+        pytest.skip('requires CUDA')
+    with torch.inference_mode():
+        weights = torch.randn(32,5,64,dtype=torch.bfloat16)
+        offloader = MemoryTableOffloader(weights,2,4,group_size=group,
+                                        prefetch_depth=depth,dedup_min_tokens=1)
+        streams = [torch.cuda.Stream(), torch.cuda.Stream()]
+        retained = []
+        try:
+            for iteration in range(8):
+                ids = torch.full((2,4),3) if iteration % 2 else torch.randint(0,32,(2,4))
+                weights.add_(0.25)
+                expected = [weights[ids,layer].clone() for layer in range(5)]
+                with torch.cuda.stream(streams[iteration%2]):
+                    keys = torch.randn(2,4,2,32,device='cuda',dtype=torch.bfloat16)
+                    outputs = []
+                    def consume(layer, handle):
+                        assert isinstance(handle, FusedPendingM)
+                        with pytest.raises(RuntimeError):
+                            handle.release()
+                        torch.cuda._sleep(10000)
+                        outputs.append(handle.add_to(keys))
+                        with pytest.raises(RuntimeError):
+                            handle.acquire()
+                        with pytest.raises(RuntimeError):
+                            handle.add_to(keys)
+                        handle.release()
+                        with pytest.raises(RuntimeError):
+                            handle.release()
+                    offloader.forward(ids, consume)
+                    refs = [keys + value.to('cuda').view_as(keys) for value in expected]
+                retained.append((outputs,refs))
+            torch.cuda.synchronize()
+            for outputs, refs in retained:
+                for actual, expected in zip(outputs, refs):
+                    torch.testing.assert_close(actual,expected,rtol=0,atol=0)
+        finally:
+            offloader.close()
