+        Logical length comes from the current view, including benchmark rollback.
+        Identity/stride checks discard ownership after external cache transforms.
+        Spare capacity is bounded by 127 positions per layer.
+        """
+        buffers = self._memory_kv_buffers
+        length = old[0].shape[1]
+        end = length + incoming[0].shape[1]
+        reusable = buffers is not None and len(buffers) == len(old)
+        if reusable:
+            reusable = all(
+                x.device == buf.device and x.dtype == buf.dtype
+                and x.data_ptr() == buf.data_ptr() and x.stride() == buf.stride()
+                and x.shape[0] == buf.shape[0] and x.shape[2:] == buf.shape[2:]
+                and 0 <= buf.shape[1] - end < 128
+                for x, buf in zip(old, buffers)
+            )
+        if not reusable:
+            capacity = ((end + 127) // 128) * 128
+            buffers = tuple(x.new_empty((x.shape[0], capacity, *x.shape[2:])) for x in old)
+            for buf, x in zip(buffers, old):
+                buf[:, :length].copy_(x)
+            self._memory_kv_buffers = buffers
+        for buf, x in zip(buffers, incoming):
+            buf[:, length:end].copy_(x)
+        return tuple(buf[:, :end] for buf in buffers)
 
